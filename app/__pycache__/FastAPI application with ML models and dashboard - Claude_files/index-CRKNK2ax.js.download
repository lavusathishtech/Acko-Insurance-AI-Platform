 after sleep or network changes",id:"ZWsDyQeFPt"})}]},{version:"1.8089.0",date:"2026-05-19",items:[{kind:"feat",text:Dm({defaultMessage:"Group sessions by PR state from the filter icon at the top of the sidebar",id:"X707sOR++o"})},{kind:"feat",text:Dm({defaultMessage:"[[cmd+u]] attaches a file from your computer",id:"qUTTUrFL4F"})},{kind:"improvement",text:Dm({defaultMessage:"Sessions remember your scroll position when you come back to them",id:"jfGIZALMiO"})}]},{version:"1.7196.0",date:"2026-05-15",items:[{kind:"feat",text:Dm({defaultMessage:"Pick your code font and theme in `Settings → Claude Code → Appearance`",id:"R4cKoaRG3c"})},{kind:"feat",text:Dm({defaultMessage:"Get a desktop notification when Claude finishes while you're in another app",id:"EJgFVunmTS"})},{kind:"feat",text:Dm({defaultMessage:"[[ctrl+]]] and [[ctrl+[]] cycle focus between split panes",id:"1pDTicCdea"})},{kind:"feat",text:Dm({defaultMessage:"Move a local session to the cloud from its `•••` menu so it keeps running when you close your laptop",id:"2Mt/gDql/P"})},{kind:"feat",text:Dm({defaultMessage:"`/usage` shows your token usage for the current session inline",id:"MJeNpHWSBI"})},{kind:"fix",text:Dm({defaultMessage:"Dotfiles show up in the file tree and `@`-mention search",id:"ZloNHabIoM"})}]},{version:"1.6608.0",date:"2026-05-07",items:[{kind:"feat",text:Dm({defaultMessage:"Create and name your own session groups — drag sessions in, or right-click a session → `Move to group`",id:"NAen74+5KK"})},{kind:"feat",text:Dm({defaultMessage:"Click any file in the file panel to edit it in place",id:"fKFZn3x9/k"})},{kind:"feat",text:Dm({defaultMessage:"Turn on Remote Control for all new local sessions in `Settings → Claude Code`",id:"BWYONtbtL0"})},{kind:"improvement",text:Dm({defaultMessage:"Resolved review comments collapse in the diff view so you can focus on what's open",id:"g8jaGMlx3n"})}]},{version:"1.6259.0",date:"2026-05-05",items:[{kind:"feat",text:Dm({defaultMessage:"Attach up to 20 images in a single message for local sessions",id:"AtQI4gQ2Qm"})},{kind:"improvement",text:Dm({defaultMessage:'"Always allow" choices now persist after you quit the app',id:"tQkGeo/pLH"})},{kind:"improvement",text:Dm({defaultMessage:"Sidebar pins and starred sessions survive sign-out",id:"+qm9S5DZcB"})}]},{version:"1.5354.0",date:"2026-04-29",items:[{kind:"feat",text:Dm({defaultMessage:"`/btw` or [[cmd+;]] opens a side chat with Claude without interrupting your main session",id:"oCUtTGiVOc"})},{kind:"feat",text:Dm({defaultMessage:"Open multiple terminal tabs in the terminal pane",id:"KpxLln6Tcc"})},{kind:"feat",text:Dm({defaultMessage:"Right-click any folder in the file tree → `Open in terminal`",id:"o93iHAIei0"})},{kind:"feat",text:Dm({defaultMessage:"Queue follow-up messages while Claude is still working — they send automatically when it's ready",id:"FJeVTW7t3g"})},{kind:"feat",text:Dm({defaultMessage:"See related and stacked PRs together in the PR bar",id:"nzAlf/Dr9C"})},{kind:"feat",text:Dm({defaultMessage:"Sort sessions from the filter icon in the sidebar",id:"bfrtsSnP8t"})},{kind:"feat",text:Dm({defaultMessage:"`/feedback` sends feedback about the current session without leaving it",id:"vMDozLqrrm"})}]},{version:"1.4758.0",date:"2026-04-24",items:[{kind:"feat",text:Dm({defaultMessage:"Drag, resize, and keyboard-navigate split panes with sessions side by side",id:"JR1Xo64s7i"})},{kind:"feat",text:Dm({defaultMessage:"Draw directly on the preview to show Claude what you mean — click the pencil icon in the preview toolbar",id:"VN6sKZ3xLJ"})},{kind:"feat",text:Dm({defaultMessage:"Markdown files render as formatted previews in the file panel",id:"Gls6MqqVlD"})},{kind:"feat",text:Dm({defaultMessage:"Right-click any file in the diff tree for `Open`, `Copy path`, and `Attach as context`",id:"s1HEb7obG9"})},{kind:"feat",text:Dm({defaultMessage:"Archive or delete several sessions at once from the Recents header menu",id:"oWtfUA9kKn"})}]},{version:"1.3883.0",date:"2026-04-21",items: