# Database
DATABASE_URL=postgresql://postgres:root@localhost:5432/acko_insurance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=acko_insurance

# PostgreSQL RDS (Production)
DB_HOST=acko-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=acko_insurance
DB_USER=acko_admin
DB_PASSWORD=your_secure_password

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=acko-insurance-models

# Auth
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE_MINUTES=1440

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
ENABLE_GEMINI_CHAT=true
ENABLE_GEMINI_DAMAGE=true
ENABLE_TENSORFLOW_DAMAGE=false

# Admin (Streamlit legacy)
DASHBOARD_PASSWORD=admin123
